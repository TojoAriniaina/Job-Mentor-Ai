# ── Base de données ─────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=jobmentor_db

# ── IA / LLM ───────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=            # optionnel, clé de secours (bascule auto en cas d'échec)
# À renseigner explicitement : sans cette ligne le projet retombe sur le modèle
# par défaut codé en dur dans config/app.php.
LLM_MODEL=google/gemini-2.0-flash-001
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions

# ── Sécurité ───────────────────────────────────────────────────
# Clé de chiffrement AES-256 des clés API stockées en base.
# Format exigé : 64 caractères hexadécimaux. Générer avec : openssl rand -hex 32
# Une clé dans un autre format est refusée (elle reviendrait silencieusement à
# une clé vide, donc à un chiffrement sans secret).
APP_KEY=

# ── Optionnel ──────────────────────────────────────────────────
APP_URL=                         # URL absolue du site (pour Open Graph, ex: https://jobmentor-ai.mg)
ELEVENLABS_API_KEY=              # clé API ElevenLabs pour la synthèse vocale
ELEVENLABS_API_KEY_2=            # optionnel, clé de secours (bascule auto si quota dépassé)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
