RewriteEngine On

# Pas de listing de répertoire (le projet est parfois exposé tel quel sous XAMPP)
Options -Indexes

# ── Blocage des fichiers sensibles ────────────────────────────
# Points cachés : à bloquer à tous les niveaux (.env, .env.example, .git…)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(log|sql)$">
    Require all denied
</FilesMatch>

# Fichiers de documentation / configuration : uniquement à la racine du projet,
# pour ne rien casser dans public/frontend/ (assets, json éventuels).
RewriteRule ^[^/]+\.(md|txt|json|lock|example|bak|sh|ini|yml|yaml)$ - [F,L]

# ── Blocage des dossiers sensibles ───────────────────────────
RewriteRule ^src/ - [F,L]
RewriteRule ^bootstrap/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^tools/ - [F,L]
RewriteRule ^database\.sql$ - [F,L]

# Les scripts PHP ne doivent être exécutés que depuis public/.
# Sans cette règle, un fichier posé à la racine (script de validation, debug)
# reste accessible et exécutable par n'importe quel visiteur.
RewriteRule ^[^/]+\.php$ - [F,L]

# ── Pas de cache sur les assets (évite les anciens utils.js/api.js en cache) ──
<FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</FilesMatch>

# ── Headers sécurité ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Static files : servir directement ───────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Tout le reste → front controller ───────────────────────────
RewriteRule ^(.*)$ public/index.php [QSA,L]
