{
    "name": "jobmentor/ai",
    "description": "Coach de carrière intelligent propulsé par l'IA",
    "type": "project",
    "private": true,
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "validate": "php tools/validation_lettre.php"
    }
}
