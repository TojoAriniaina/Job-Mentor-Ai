# Normalise les fins de ligne dans le dépôt (LF) quel que soit le poste de travail.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary

# Fichiers qui doivent rester en CRLF sous Windows
*.bat text eol=crlf
*.cmd text eol=crlf
